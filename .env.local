# Placeholder environment variables for local development
# Replace the values below with your actual API keys before running the app.

GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: set Vite port (if you want to run on a different port)
# VITE_PORT=3000

# Firebase or other backend keys (if required by the project)
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
# FIREBASE_PROJECT_ID=your_firebase_project_id
